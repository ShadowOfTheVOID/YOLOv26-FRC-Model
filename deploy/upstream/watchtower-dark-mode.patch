+
+/* ---------- dark mode: follows the phone or laptop's setting
+   Refs, scorers and the emcee hold phones in dim gyms, where a white page is
+   the brightest thing in the stands. Light mode is unchanged. The field
+   display and the stream overlay keep their own look (class="fixed-theme"
+   on their <html>): one is a TV across the gym, the other is drawn over
+   the stream, and both already use dark backgrounds. */
+@media (prefers-color-scheme: dark) {
+  :root:not(.fixed-theme) {
+    color-scheme: dark;
+    --wall: #0b0d10; --panel: #15181c; --panel-2: #1c2025; --ink: #eceef1; --ink-2: #c0c6ce;
+    --muted: #8a939e; --line: #262b31; --line-strong: #363c45;
+    --red: #ff4b65; --red-soft: rgba(255, 75, 101, .11); --red-line: rgba(255, 75, 101, .38);
+    --blue: #4f8fff; --blue-soft: rgba(79, 143, 255, .11); --blue-line: rgba(79, 143, 255, .38);
+    --ok: #3ccf87; --ok-soft: rgba(60, 207, 135, .13); --warn: #f0a43a; --warn-soft: rgba(240, 164, 58, .13);
+    --fuel-soft: rgba(244, 195, 0, .16);
+    --shadow: 0 1px 2px rgba(0, 0, 0, .35);
+    --on-ink: #0b0d10; --bar: #111418;
+  }
+  :root:not(.fixed-theme) .bar { border-bottom: 1px solid rgba(255, 255, 255, .06); }
+  :root:not(.fixed-theme) .warnbox { border-color: rgba(240, 164, 58, .35); color: var(--warn); }
+  :root:not(.fixed-theme) .toast.err { color: #fff; }
+}
